{
  "entity": {
    "sensor": {
      "status": {
        "default": "mdi:solar-power",
        "state": {
          "offline": "mdi:power-plug-off",
          "alarm": "mdi:alert",
          "stale": "mdi:cloud-off-outline",
          "unknown": "mdi:help-circle-outline"
        }
      },
      "battery_power": {
        "default": "mdi:battery",
        "range": {
          "-1000000": "mdi:battery-arrow-down",
          "0": "mdi:battery",
          "0.001": "mdi:battery-arrow-up"
        }
      },
      "battery_soh": { "default": "mdi:battery-heart" },
      "force_charge_soc": { "default": "mdi:battery-arrow-up" },
      "force_discharge_soc": { "default": "mdi:battery-arrow-down" }
    },
    "binary_sensor": {
      "alarm": {
        "default": "mdi:alert",
        "state": {
          "off": "mdi:check-circle-outline"
        }
      }
    }
  }
}
